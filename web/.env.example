# Use the exact deployed origin in staging/production (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backward-compatible alias used by older deployments.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public DSN for the Kanvise Web Sentry project. This is safe to expose to browsers.
NEXT_PUBLIC_SENTRY_DSN=
# Set explicitly per deployment so staging events never mix with production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Used only during CI/Vercel builds to upload source maps; never expose this to browsers.
SENTRY_AUTH_TOKEN=
# Optional release identifier. CI should set this to the deployed Git SHA.
SENTRY_RELEASE=
# Public release identifier used to match browser errors to uploaded source maps.
NEXT_PUBLIC_SENTRY_RELEASE=
