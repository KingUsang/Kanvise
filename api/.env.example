# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SCHEDULED_JOBS_ENABLED=false

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Payments and invitations
PAYSTACK_SECRET_KEY=
KANVISE_INTERNAL_SECRET=
INVITE_TOKEN_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_LOGO_URL=

# Gemini document import
GEMINI_API_KEY=
GEMINI_MOCK_IMPORT_MODEL=gemini-2.5-flash

# Telegram is disabled unless explicitly enabled.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Browser Web Push is disabled unless explicitly enabled. Generate a separate
# VAPID key pair for every environment and keep the private key server-only.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com
