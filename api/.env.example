# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: accept Vercel previews for one team only, e.g. -your-team.vercel.app
CORS_VERCEL_PREVIEW_SUFFIX=
SCHEDULED_JOBS_ENABLED=false

# Sentry (Kanvise API project). The DSN identifies the project; it is not a secret.
SENTRY_DSN=
# Set explicitly per deployment, for example: production or staging.
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SUPPORT_EMAIL=hello@kanvise.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments and invitations
PAYSTACK_SECRET_KEY=
KANVISE_INTERNAL_SECRET=
CLASS_LINK_ENCRYPTION_KEY=

# Public form rate limits (DEV-PUB-004). Same random value (32+ characters) as
# the web KANVISE_PROXY_SECRET. When it matches, the API keys waitlist,
# suggestion and landing-event limits on the visitor address the web proxy
# forwards. Unset or shorter than 16 characters: forwarded addresses are
# ignored and limits key on the last X-Forwarded-For hop added by Caddy.
KANVISE_PROXY_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# PlugNMeet classroom provider (required in production)
PLUGNMEET_SERVER_URL=
PLUGNMEET_API_KEY=
PLUGNMEET_API_SECRET=
PLUGNMEET_WEBHOOK_SECRET=
# Optional provider callback and health endpoint overrides.
PLUGNMEET_WEBHOOK_URL=
PLUGNMEET_HEALTH_URL=

# Optional PlugNMeet VM control and recorder fleet
PLUGNMEET_WORKER_CONTROL_ENABLED=false
AZURE_SUBSCRIPTION_ID=
AZURE_PLUGNMEET_RESOURCE_GROUP=
AZURE_PLUGNMEET_VM_NAME=
AZURE_MANAGEMENT_ACCESS_TOKEN=
RECORDER_FLEET_ENABLED=false
RECORDER_FLEET_CONTROLLER_URL=
RECORDER_FLEET_CONTROLLER_SECRET=
RECORDER_CALLBACK_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_LOGO_URL=

# Gemini document import
GEMINI_API_KEY=
GEMINI_MOCK_IMPORT_MODEL=gemini-2.5-flash

# Browser Web Push is disabled unless explicitly enabled. Generate a separate
# VAPID key pair for every environment and keep the private key server-only.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com
