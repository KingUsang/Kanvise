{
  "name": "api",
  "version": "1.0.0",
  "description": "Kanvise Hono API",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "email:smoke": "npm run build && node dist/scripts/email-smoke.js",
    "push:vapid": "web-push generate-vapid-keys --json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@hono/node-server": "^2.1.0",
    "@napi-rs/canvas": "^1.0.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/supabase-js": "^2.47.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "hono": "^4.13.0",
    "livekit-server-sdk": "^2.17.0",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "^6.2.108",
    "resend": "^6.17.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/web-push": "3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
